{
  "name": "WordPal 单词小搭子",
  "appid": "__UNI__B07BDFA",
  "description": "自然拼读、科学复习、四象伙伴陪伴学习",
  "versionName": "1.2.8",
  "versionCode": "128",
  "transformPx": false,
  "vueVersion": "3",
  "app-plus": {
    "usingComponents": true,
    "compilerVersion": 3,
    "nvueStyleCompiler": "uni-app",
    "screenOrientation": [
      "portrait-primary",
      "portrait-secondary",
      "landscape-primary",
      "landscape-secondary"
    ],
    "safearea": {
      "background": "#fff9f2",
      "bottom": {
        "offset": "none"
      },
      "backgroundDark": "#080b18"
    },
    "splashscreen": {
      "alwaysShowBeforeRender": true,
      "waiting": true,
      "autoclose": true,
      "delay": 0
    },
    "modules": {
      "Audio": {}
    },
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.RECORD_AUDIO\"/>"
        ],
        "minSdkVersion": 23,
        "targetSdkVersion": 35
      },
      "ios": {
        "dSYMs": false,
        "privacyDescription": {
          "NSMicrophoneUsageDescription": "用于跟读时录音并在本地回放，不上传录音。"
        }
      },
      "icons": {
        "android": {
          "ldpi": "src/static/icons/icon-48.png",
          "mdpi": "src/static/icons/icon-48.png",
          "hdpi": "src/static/icons/icon-72.png",
          "xhdpi": "src/static/icons/icon-96.png",
          "xxhdpi": "src/static/icons/icon-144.png",
          "xxxhdpi": "src/static/icons/icon-192.png"
        },
        "ios": {
          "appstore": "src/static/icons/icon-1024.png",
          "iphone": {
            "app@2x": "src/static/icons/icon-120.png",
            "app@3x": "src/static/icons/icon-180.png",
            "notification@2x": "src/static/icons/icon-40.png",
            "notification@3x": "src/static/icons/icon-60.png",
            "settings@2x": "src/static/icons/icon-58.png",
            "settings@3x": "src/static/icons/icon-87.png",
            "spotlight@2x": "src/static/icons/icon-80.png",
            "spotlight@3x": "src/static/icons/icon-120.png"
          },
          "ipad": {
            "app": "src/static/icons/icon-76.png",
            "app@2x": "src/static/icons/icon-152.png",
            "proapp@2x": "src/static/icons/icon-167.png",
            "notification": "src/static/icons/icon-20.png",
            "notification@2x": "src/static/icons/icon-40.png",
            "settings": "src/static/icons/icon-29.png",
            "settings@2x": "src/static/icons/icon-58.png",
            "spotlight": "src/static/icons/icon-40.png",
            "spotlight@2x": "src/static/icons/icon-80.png"
          }
        }
      }
    },
    "statistics": {
      "enable": false
    },
    "statusbar": {
      "immersed": "supportedDevice",
      "style": "dark",
      "background": "#fff9f2"
    },
    "darkmode": true
  },
  "h5": {
    "title": "WordPal · 单词小搭子",
    "router": {
      "mode": "hash"
    }
  },
  "mp-weixin": {
    "appid": "",
    "usingComponents": true,
    "setting": {
      "urlCheck": true
    },
    "darkmode": true
  },
  "uniStatistics": {
    "enable": false
  }
}
