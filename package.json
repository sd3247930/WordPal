{
  "name": "wordpal",
  "version": "1.2.0",
  "private": true,
  "description": "离线优先的自然拼读与四象伙伴学习应用",
  "scripts": {
    "dev:h5": "uni --host 0.0.0.0 --port 5173",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:golden": "playwright test tests/ui/golden.spec.ts",
    "icons": "node tools/export-icons.mjs",
    "sync:hbuilder": "powershell -ExecutionPolicy Bypass -File tools/sync-hbuilder.ps1",
    "check:compiler": "node tools/check-compiler.mjs",
    "purity": "powershell -ExecutionPolicy Bypass -File tools/preflight-scan.ps1",
    "git:hooks": "node tools/install-git-hooks.mjs",
    "pets:export": "node tools/export-pet-assets.mjs",
    "predev:h5": "node tools/check-compiler.mjs --dependencies-only",
    "prebuild:h5": "node tools/check-compiler.mjs --dependencies-only",
    "prebuild:app": "node tools/check-compiler.mjs --dependencies-only",
    "prebuild:mp-weixin": "node tools/check-compiler.mjs --dependencies-only",
    "course:import": "tsx tools/import-course/index.ts",
    "course:validate": "tsx tools/import-course/index.ts --file src/content/courses/original-primary.json --public",
    "icons:controls": "tsx tools/export-control-icons.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "fflate": "0.8.3",
    "pinia": "2.1.7",
    "ts-fsrs": "5.4.2",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "ajv": "8.17.1",
    "sass": "1.80.7",
    "sharp": "0.34.4",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  }
}
