{
  "name": "wordpal",
  "version": "1.2.4",
  "private": true,
  "description": "离线优先的自然拼读与四象伙伴学习应用",
  "scripts": {
    "dev:h5": "uni --host 127.0.0.1 --port 5173",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:mp-weixin": "uni build -p mp-weixin",
    "typecheck": "vue-tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:ui": "playwright test",
    "test:golden": "playwright test tests/ui/golden.spec.ts",
    "icons": "node tools/export-icons.mjs",
    "sync:hbuilder": "powershell -ExecutionPolicy Bypass -File tools/sync-hbuilder.ps1",
    "check:compiler": "node tools/check-compiler.mjs",
    "check:release": "node tools/check-release-isolation.mjs",
    "purity": "powershell -ExecutionPolicy Bypass -File tools/preflight-scan.ps1",
    "git:hooks": "node tools/install-git-hooks.mjs",
    "pets:export": "node tools/export-pet-assets.mjs",
    "predev:h5": "node tools/prepare-local-content.mjs && node tools/check-compiler.mjs --dependencies-only",
    "prebuild:h5": "node tools/prepare-local-content.mjs --release && node tools/check-compiler.mjs --dependencies-only",
    "prebuild:app": "node tools/prepare-local-content.mjs --release && node tools/check-compiler.mjs --dependencies-only && node tools/check-app-icons.mjs",
    "prebuild:mp-weixin": "node tools/prepare-local-content.mjs --release && node tools/check-compiler.mjs --dependencies-only",
    "course:import": "tsx tools/import-course/index.ts",
    "course:validate": "tsx tools/import-course/index.ts --file src/content/courses/original-primary.json --public",
    "icons:controls": "tsx tools/export-control-icons.ts",
    "pretest": "node tools/prepare-local-content.mjs",
    "pretypecheck": "node tools/prepare-local-content.mjs",
    "postinstall": "node tools/prepare-local-content.mjs",
    "vocabulary:import": "tsx tools/master-vocabulary/index.ts",
    "fltrp:import": "tsx tools/import-fltrp/index.ts",
    "fltrp:validate": "tsx tools/import-fltrp/validate-cli.ts",
    "check:app-icons": "node tools/check-app-icons.mjs",
    "postbuild:app": "node tools/check-app-icons.mjs --output dist/build/app"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "fflate": "0.8.3",
    "pinia": "2.1.7",
    "ts-fsrs": "5.4.2",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@playwright/test": "1.56.1",
    "@types/node": "22.19.0",
    "ajv": "8.20.0",
    "sass": "1.80.7",
    "sharp": "0.35.5",
    "tsx": "4.20.6",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  },
  "overrides": {
    "@babel/core": "7.29.7",
    "vue-i18n": "$vue-i18n",
    "@intlify/core-base": "9.14.5",
    "@intlify/message-resolver": "9.1.11",
    "@intlify/message-compiler": "9.14.5",
    "@intlify/shared": "9.14.5",
    "postcss": "8.5.30",
    "qs": "6.16.1",
    "source-map-js": "1.2.2",
    "ws@^8": "8.22.0",
    "express@^4": "4.22.3",
    "body-parser@^1": "1.20.8",
    "cookie@<0.7.0": "0.7.2",
    "send@<0.19.0": "0.19.2",
    "path-to-regexp@<0.1.13": "0.1.13",
    "jpeg-js@<0.4.4": "0.4.4",
    "phin@<3.7.1": "3.7.1",
    "adm-zip@<0.6.1": "0.6.1",
    "postcss-selector-parser@<7.1.6": "7.1.6"
  }
}
